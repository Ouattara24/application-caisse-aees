# Variables d'environnement pour le déploiement sur Render
# Copiez ce fichier vers .env et ajustez les valeurs

# Clé secrète Django (générez une nouvelle clé sécurisée pour la production)
SECRET_KEY=your-very-long-random-secret-key-here

# Mode debug (False en production)
DEBUG=False

# URL de la base de données (sera automatiquement configurée par Render)
DATABASE_URL=postgresql://...